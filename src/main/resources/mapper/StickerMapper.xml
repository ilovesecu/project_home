<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ilovepc.project_home.repository.PraiseStickerMapper">
    <insert id="stampSticker" parameterType="com.ilovepc.project_home.web.sticker.vo.StampStickerParam"
        useGeneratedKeys="true" keyProperty="slotId">
        INSERT INTO home_project.praise_stickers(board_id, user_no, slot_id, sticker_url)
        VALUES (#{boardId},#{userNo},#{slotId},#{stickerUrl})
    </insert>

    <resultMap id="BoardStickerMap" type="com.ilovepc.project_home.web.sticker.vo.BoardResult">
        <id property="id" column="board_id"/>
        <result property="title" column="title"/>
        <result property="goal" column="goal"/>
        <result property="rewardItem" column="reward_item"/>
        <result property="isRewarded" column="is_rewarded"/>
        <result property="status" column="status"/>
        <result property="totalSlots" column="total_slots"/>
        <result property="createdAt" column="created_at"/>
        <result property="completedAt" column="completed_at"/>
        <collection property="placedStickers" ofType="com.ilovepc.project_home.web.sticker.vo.StampStickerResult">
            <result property="boardId" column="board_id"/>
            <result property="slotId" column="slot_id"/>
            <result property="stickerUrl" column="sticker_url"/>
            <result property="stampedAt" column="stamped_at"/>
            <result property="nickname" column="nickname"/>
        </collection>
    </resultMap>

    <select id="getBoards" resultMap="BoardStickerMap">
        SELECT
            b.id AS board_id, b.title, b.goal, b.reward_item, b.is_rewarded,
            b.status, b.total_slots, b.created_at, b.completed_at,
            u1.nickname, s.slot_id, s.sticker_url, s.stamped_at
        FROM (
                 SELECT
                     *
                 FROM home_project.praise_boards
                 WHERE status = 'IN_PROGRESS'
                 ORDER BY created_at DESC
                 LIMIT 10
             )b
                 LEFT JOIN home_project.praise_stickers s ON b.id = s.board_id
                 LEFT JOIN home_project.users u1 ON s.user_no = u1.user_no
        ORDER BY b.created_at DESC, s.slot_id ASC;
    </select>
</mapper>